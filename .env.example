# Cliffhanger Store — variáveis de ambiente (exemplo, sem segredos)
# Copie este arquivo para `.env.local` e preencha os valores reais.
# Os valores reais ficam apenas no seu ambiente local e no painel da Vercel.

# Firebase Web (client) — em `NEXT_PUBLIC_`, visível ao navegador
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — service account JSON em linha única (NUNCA committar)
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# PagBank (Checkout) — SANDBOX
PAGBANK_TOKEN=
PAGBANK_SANDBOX=true

# Login com Facebook (opcional — sem este valor o botão Facebook exibe aviso)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Admin — super admin único: exatamente UM e-mail (sem vírgulas/lista).
# Sem este valor, ninguém acessa as APIs do painel (negar por padrão).
SUPER_ADMIN_EMAIL=

# Base URL (para webhooks/back_urls)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Melhor Envio (cálculo de frete dos Correios)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGEM=

# E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
